<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:padding="10dp"
        android:text="直接点击下方中文地图选点（支持缩放/拖动），选好后可打开百度地图查看"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="8dp" />

    <!-- 国内直连中文交互地图 -->
    <WebView
        android:id="@+id/webViewMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGetRealLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="回到当前位置"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRandomNearby"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="附近随机点"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenBaidu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="打开百度地图看"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStopMock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止定位"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNorth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="北 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSouth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="南 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnWest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="西 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="东 100m"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
