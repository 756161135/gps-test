<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:padding="10dp"
        android:text="1. 先在地图上点击或滑动找位置\n2. 再点击下方绿色【确认定位到此位置】按钮生效"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="8dp" />

    <!-- 国内直连中文交互地图 -->
    <WebView
        android:id="@+id/webViewMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- 醒目的确认定位大按钮 -->
    <Button
        android:id="@+id/btnConfirmLocation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#2E7D32"
        android:text="📍 确认定位到此位置（开启悬浮窗）"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGetRealLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="回到真实位置"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRandomNearby"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="附近随机定位"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenBaidu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="打开百度地图"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStopMock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止模拟"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNorth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="北 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSouth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="南 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnWest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="西 100m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="东 100m"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
